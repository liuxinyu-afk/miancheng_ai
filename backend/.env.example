# ========== 绵城AI学习集市 环境配置 ==========
# 复制此文件为 .env 并修改对应配置

# --- MySQL 数据库 ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=personal_growth_platform

# --- JWT 配置 ---
SECRET_KEY=your-secret-key-change-this-to-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI 大模型接口 ---
# 豆包/通义千问/智谱GLM 任选一个，填入你的 API Key
AI_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
AI_API_KEY=your-ai-api-key
AI_MODEL=doubao-pro-32k

# --- 服务配置 ---
APP_NAME=绵城AI学习集市
APP_VERSION=2.4.0
DEBUG=True
