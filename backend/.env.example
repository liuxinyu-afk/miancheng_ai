# ========== 绵城AI学习集市 环境配置 ==========
# 复制此文件为 .env 并修改对应配置
# 部署到 Render 时，在 Render 控制台设置相同的环境变量

# --- MySQL 数据库 ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=personal_growth_platform
DB_SSL=false  # 云数据库（TiDB/Aiven）设为 true

# --- JWT 配置 ---
SECRET_KEY=your-secret-key-change-this-to-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI 大模型接口 ---
# 豆包/通义千问/智谱GLM 任选一个，填入你的 API Key
AI_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
AI_API_KEY=your-ai-api-key
AI_MODEL=glm-4-flash
AI_VISION_MODEL=glm-4v-flash

# --- 服务配置 ---
APP_NAME=绵城AI学习集市
APP_VERSION=2.4.0
DEBUG=False